<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ValletProjeto" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Cores principais usando a paleta Vallet -->
        <item name="colorPrimary">@color/vallet_green_dark</item>
        <item name="colorPrimaryVariant">@color/vallet_green_dark</item>
        <item name="colorOnPrimary">@color/vallet_surface</item>
        <item name="colorSecondary">@color/vallet_green</item>
        <item name="colorSecondaryVariant">@color/vallet_green_dark</item>
        <item name="colorOnSecondary">@color/vallet_surface</item>

        <item name="android:statusBarColor">@color/vallet_background</item>
        <item name="android:windowLightStatusBar">true</item>

        <item name="android:windowBackground">@color/vallet_background</item>

        <item name="colorControlActivated">@color/vallet_green_dark</item>
        <item name="colorControlHighlight">@color/vallet_green_muted</item>

        <item name="android:colorBackground">@color/vallet_background</item>
        <item name="android:navigationBarColor">@color/vallet_surface</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <style name="Theme.ValletProjeto" parent="Base.Theme.ValletProjeto" />

    <!--    <style name="CustomBottomNavigationViewIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
            <item name="android:color">@color/vallet_green_muted</item>
        </style>-->

    <style name="DialogTheme" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="android:windowBackground">@drawable/form_background</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowSoftInputMode">stateAlwaysVisible</item>
        <item name="android:statusBarColor">@color/vallet_green_dark</item>

        <item name="colorControlActivated">@color/vallet_green_dark</item>
        <item name="colorControlHighlight">@color/vallet_green_muted</item>

        <item name="colorPrimary">@color/vallet_green_dark</item>
        <item name="colorSecondary">@color/vallet_green</item>
    </style>

    <style name="TextInputStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/vallet_green_dark</item>
        <item name="hintTextColor">@color/vallet_green_muted</item>
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
        <item name="startIconTint">@color/vallet_green_dark</item>
    </style>

</resources>
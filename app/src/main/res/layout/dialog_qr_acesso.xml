<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_raio"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_qr_titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_semibold"
        android:text="QR Code de Acesso"
        android:textColor="@color/vallet_green_dark"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tv_qr_estacionamento_nome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:fontFamily="@font/poppins_medium"
        android:gravity="center"
        android:textColor="@color/vallet_text"
        android:textSize="14sp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="12dp"
        app:cardBackgroundColor="@color/white"
        app:cardElevation="2dp"
        app:strokeColor="@color/vallet_green_light"
        app:strokeWidth="1dp"
        app:cardCornerRadius="20dp">

        <ImageView
            android:id="@+id/iv_qr_code"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:contentDescription="QR Code de Acesso"
            android:padding="12dp"
            android:scaleType="fitCenter" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tv_qr_instrucao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/poppins_medium"
        android:gravity="center"
        android:text="Apresente este QR Code na entrada do estacionamento."
        android:textColor="@color/vallet_text_secondary"
        android:textSize="13sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_qr_fechar"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/poppins_semibold"
        android:text="Fechar"
        android:textColor="@color/white"
        android:textSize="15sp"
        app:backgroundTint="@color/vallet_green_dark"
        app:cornerRadius="16dp" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_raio"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_dialog_raio_titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_semibold"
        android:text="Raio de Distância"
        android:textColor="@color/vallet_green_dark"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tv_dialog_raio_subtitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:fontFamily="@font/poppins_medium"
        android:text="Exibir estacionamentos dentro de:"
        android:textColor="@color/vallet_text_secondary"
        android:textSize="13sp" />

    <RadioGroup
        android:id="@+id/rg_raio_opcoes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/rb_raio_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp"
            android:text="1 km"
            android:textColor="@color/vallet_text_primary"
            android:textSize="15sp"
            app:buttonTint="@color/vallet_green_dark" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/rb_raio_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp"
            android:text="2 km"
            android:textColor="@color/vallet_text_primary"
            android:textSize="15sp"
            app:buttonTint="@color/vallet_green_dark" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/rb_raio_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp"
            android:text="3 km"
            android:textColor="@color/vallet_text_primary"
            android:textSize="15sp"
            app:buttonTint="@color/vallet_green_dark" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/rb_raio_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp"
            android:text="4 km"
            android:textColor="@color/vallet_text_primary"
            android:textSize="15sp"
            app:buttonTint="@color/vallet_green_dark" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/rb_raio_5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp"
            android:text="5 km"
            android:textColor="@color/vallet_text_primary"
            android:textSize="15sp"
            app:buttonTint="@color/vallet_green_dark" />
    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dialog_raio_cancelar"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:text="Cancelar"
            android:textColor="@color/vallet_green_dark"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dialog_raio_aplicar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="Aplicar"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:backgroundTint="@color/vallet_green_dark"
            app:cornerRadius="14dp" />
    </LinearLayout>
</LinearLayout>

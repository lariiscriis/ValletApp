<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vallet_background">

    <!-- TopBar Fixa Compacta (Foto + Nome do Motorista) -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_dashboard_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:cardBackgroundColor="@color/vallet_green_light"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/iv_profile_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Foto do perfil"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_default_profile" />

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bem-vindo(a),"
                android:textColor="@color/vallet_text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_user_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Nome do motorista"
                android:textColor="@color/vallet_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_account_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Motorista"
                android:textColor="@color/vallet_green"
                android:textSize="12sp" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_logout"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:contentDescription="Sair da conta"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text=""
            app:backgroundTint="@color/vallet_background"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_logout"
            app:iconGravity="textStart"
            app:iconTint="@color/vallet_green_dark"
            app:strokeColor="@color/vallet_green_light" />

    </LinearLayout>

    <!-- Área reservada para carregar os Fragments -->
    <FrameLayout
        android:id="@+id/content_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_bar" />

    <!-- Barra de Navegação Inferior -->
    <LinearLayout
        android:id="@+id/bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_bottom_navigation"
        android:elevation="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/nav_spots"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_ripple"
            android:clickable="true"
            android:contentDescription="Vagas"
            android:focusable="true"
            android:padding="19dp"
            android:src="@drawable/icons8_local"
            app:tint="@drawable/nav_item_color_state" />

        <ImageView
            android:id="@+id/nav_dashboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_ripple"
            android:clickable="true"
            android:contentDescription="Início"
            android:focusable="true"
            android:padding="19dp"
            android:src="@drawable/icons8_home"
            app:tint="@drawable/nav_item_color_state" />

        <!-- Vão do FAB -->


        <ImageView
            android:id="@+id/nav_vehicles"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_ripple"
            android:clickable="true"
            android:contentDescription="Veículos"
            android:focusable="true"
            android:padding="19dp"
            android:src="@drawable/icons8_car"
            app:tint="@drawable/nav_item_color_state" />

        <ImageView
            android:id="@+id/nav_extra"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_ripple"
            android:clickable="true"
            android:contentDescription="Perfil"
            android:focusable="true"
            android:padding="19dp"
            android:src="@drawable/icons8_person"
            app:tint="@drawable/nav_item_color_state" />

    </LinearLayout>

    <!-- Assistente de Voz de IA (losango) -->
    <FrameLayout
        android:id="@+id/fab_voice_assistant"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="-40dp"
        android:clickable="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:contentDescription="Assistente IA"
        android:elevation="20dp"
        android:focusable="true"
        app:layout_constraintBottom_toTopOf="@+id/bottom_navigation"
        app:layout_constraintEnd_toEndOf="@+id/bottom_navigation"
        app:layout_constraintStart_toStartOf="@+id/bottom_navigation">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:rotation="45"
            app:cardBackgroundColor="@color/vallet_green"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp" />

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:elevation="12dp"
            android:importantForAccessibility="no"
            android:src="@drawable/icons8_ai"
            app:tint="@android:color/white" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
<!-- activity_reserva.xml -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
<!--    android:layout_marginTop="24dp"-->
<!--    android:layout_marginBottom="24dp">-->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Card de Informações da Vaga e Veículo (permanece o mesmo ) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"

            app:cardBackgroundColor="@color/branco"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/cinza"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_vaga_numero"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/verdeescuro"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="Vaga A-01" />

                <TextView
                    android:id="@+id/tv_vaga_detalhes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    tools:text="Tipo: Carro • Local: Térreo" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="?android:attr/listDivider" />

                <TextView
                    android:id="@+id/tv_veiculo_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    tools:text="Veículo: Fiat Mobi (ABC-1234 )" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>




        <!-- Círculo com o carro (sempre visível) -->
        <FrameLayout
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/circle_progress_background">

            <ImageView
                android:id="@+id/gif_carro"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                tools:src="@drawable/reserva_carro"/>
        </FrameLayout>

        <!-- Container para o seletor de tempo OU o timer -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true">

            <!-- Grupo de Seleção de Tempo (visível ANTES da reserva) -->
            <LinearLayout
                android:id="@+id/layout_config_reserva"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Selecione o tempo da reserva"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tv_tempo_selecionado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:textColor="@color/preto"
                    tools:text="01:00" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_tempo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/slider"
                    android:stepSize="1.0"
                    android:value="1.0"
                    android:valueFrom="1.0"
                    android:valueTo="4.0"
                    app:haloColor="@color/verdeclaro"
                    app:thumbColor="@color/verdeescuro"
                    app:thumbStrokeColor="@color/preto"
                    app:tickColor="@color/verdeescuro"
                    app:tickColorActive="@color/verdeescuro"
                    app:trackColorActive="@color/verdeclaro"
                    app:trackColorInactive="@color/cinza" />
            </LinearLayout>

            <!-- Grupo do Timer (visível DURANTE a reserva) -->
            <LinearLayout
                android:id="@+id/layout_timer_reserva"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tempo Restante"/>

                <TextView
                    android:id="@+id/tv_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="48sp"
                    android:textStyle="bold"
                    android:textColor="@color/preto"
                    tools:text="59:59" />

                <TextView
                    android:id="@+id/tv_horario_reserva"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Reserva das 14:00 às 15:00" />
            </LinearLayout>

        </FrameLayout>

        <View
            android:layout_width="100dp"
            android:layout_height="100dp"/>

        <!-- ===================== BOTÕES DE AÇÃO ===================== -->

        <!-- Verificar Rota: sempre visível, largura total -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_verificar_rota"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="Verificar Rota"
            android:textAllCaps="false"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_parking"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:backgroundTint="@color/verdeclaro" />

        <!-- Confirmar Reserva: visível apenas ANTES da reserva ser criada -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reservar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:text="Confirmar Reserva"
            android:textAllCaps="false"
            app:cornerRadius="16dp"
            app:backgroundTint="@color/verdeescuro" />

        <!-- Renovar + Finalizar: lado a lado, visíveis com a reserva ATIVA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_renovar"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Renovar"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_schedule"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:iconSize="16dp"
                app:strokeColor="@color/verdeescuro"
                android:textColor="@color/verdeescuro"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_finalizar"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Finalizar"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_flag"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:iconSize="16dp"
                app:backgroundTint="@color/verdeescuro"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Cancelar Reserva: ação destrutiva, visual discreto, separada das demais -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancelar"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Cancelar Reserva"
            android:textAllCaps="false"
            app:icon="@drawable/ic_cancel"
            app:iconGravity="textStart"
            app:iconSize="16dp"
            app:iconTint="@android:color/holo_red_dark"
            android:textColor="@android:color/holo_red_dark"
            android:textSize="13sp"
            android:visibility="gone"/>

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"/>

    </LinearLayout>
</ScrollView>
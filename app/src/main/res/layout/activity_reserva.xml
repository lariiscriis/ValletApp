<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vallet_background"
    android:fitsSystemWindows="true"
    android:clipToPadding="false"
    android:paddingBottom="24dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <!-- ================= CABEÇALHO (VOLTAR + TÍTULO) ================= -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <!-- Botão de Voltar -->
            <ImageView
                android:id="@+id/btn_voltar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical|start"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/vallet_green_dark"
                android:contentDescription="Seta para voltar" />

            <!-- Informações do Veículo Centradas -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_veiculo_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/vallet_green_dark"
                    android:textSize="24sp"
                    tools:text="Fiat Mobi" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Veículo Selecionado"
                    android:textColor="@color/vallet_green"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- ================= ANEL CENTRAL COM O CARRO ================= -->
        <FrameLayout
            android:layout_width="210dp"
            android:layout_height="210dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp">

            <!-- Fundo que pulsa -->
            <View
                android:id="@+id/circulo_fundo_animado"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/circle_progress_background" />

            <!-- Carro  -->
            <ImageView
                android:id="@+id/gif_carro"
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:layout_gravity="center"
                android:contentDescription="Veículo"
                android:src="@drawable/carro_vagaocupada" />
        </FrameLayout>

        <!-- ================= SELEÇÃO DE TEMPO / TIMER ================= -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true">

            <LinearLayout
                android:id="@+id/layout_config_reserva"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Selecione a Duração"
                    android:textColor="@color/vallet_green"
                    android:textSize="13sp" />

                <!-- Texto informando o limite máximo de horas -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif"
                    android:text="Máximo de 4 horas permitidas"
                    android:textColor="@color/vallet_green_muted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_tempo_selecionado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/vallet_green_dark"
                    android:textSize="40sp"
                    tools:text="01:00 min" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_tempo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="1.0"
                    android:value="1.0"
                    android:valueFrom="1.0"
                    android:valueTo="4.0"
                    app:haloColor="@color/vallet_green_light"
                    app:thumbColor="@color/vallet_green_dark"
                    app:thumbStrokeColor="@color/white"
                    app:thumbStrokeWidth="2dp"
                    app:tickColor="@color/vallet_green_dark"
                    app:tickColorActive="@color/white"
                    app:trackColorActive="@color/vallet_green_dark"
                    app:trackColorInactive="@color/vallet_green_light" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_timer_reserva"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Tempo Restante"
                    android:textColor="@color/vallet_green"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/vallet_green_dark"
                    android:textSize="44sp"
                    tools:text="30 : 20 min" />

                <TextView
                    android:id="@+id/tv_horario_reserva"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/vallet_green"
                    android:textSize="13sp"
                    tools:text="12:10 PM - 01 Dec 2021" />
            </LinearLayout>
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="16dp" />

        <!-- ================= CARD DA VAGA ================= -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/vallet_green_dark"
            app:cardCornerRadius="20dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vaga / Zona"
                        android:textColor="@color/vallet_green_light"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_vaga_numero"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        tools:text="A-013" />

                    <TextView
                        android:id="@+id/tv_vaga_detalhes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/vallet_green_light"
                        android:textSize="11sp"
                        tools:text="Tipo: Carro • Local: Térreo" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_card_mapa"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="14dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_parking"
                        app:tint="@color/vallet_green_dark" />
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ================= BOTÕES DE AÇÃO  ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_verificar_rota"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:fontFamily="sans-serif-bold"
                android:text="Rota"
                android:textAllCaps="false"
                android:textColor="@color/vallet_green_dark"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_parking"
                app:iconTint="@color/vallet_green_dark"
                app:strokeColor="@color/vallet_green_dark" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_reservar"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1.5"
                android:fontFamily="sans-serif-bold"
                android:text="Confirmar"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:backgroundTint="@color/vallet_green_dark"
                app:cornerRadius="20dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_renovar"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-bold"
                android:text="Renovar"
                android:textAllCaps="false"
                android:textColor="@color/vallet_green_dark"
                android:visibility="gone"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_schedule"
                app:iconTint="@color/vallet_green_dark"
                app:strokeColor="@color/vallet_green_dark"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_finalizar"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-bold"
                android:text="Finalizar"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:visibility="gone"
                app:backgroundTint="@color/vallet_green_dark"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_flag"
                app:iconTint="@color/white"
                tools:visibility="visible" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancelar"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Cancelar Reserva"
            android:background="@drawable/bg_status_fechado"
            android:textAllCaps="false"
            android:textColor="@color/red_cancel"
            android:visibility="gone"
            app:icon="@drawable/ic_cancel"
            app:iconGravity="textStart"
            app:iconTint="@color/red_cancel"
            tools:visibility="visible" />

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
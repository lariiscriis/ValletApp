<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F2EB"
    tools:context=".LoginActivity">

    <!-- ÁREA SUPERIOR COM A IMAGEM DE FUNDO -->
    <FrameLayout
        android:id="@+id/topArea"
        android:layout_width="match_parent"
        android:layout_height="340dp"
        android:background="#CBD9C5"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgParkingBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/op2_backgroung"
            android:contentDescription="@null" />

        <!-- Logo e Título Vallet -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginTop="56dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="160dp"
                    android:layout_height="70dp"
                    android:layout_marginStart="-15dp"
                    android:scaleType="fitStart"
                    android:adjustViewBounds="true"
                    android:src="@drawable/op2_logo"
                    android:contentDescription="Logo Vallet" />

<!--                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Vallet"
                    android:textColor="#3B5942"
                    android:textSize="28sp"
                    android:textStyle="bold" />-->
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-10dp"
                android:fontFamily="@font/poppins"
                android:text="Estacionar ficou\nmais inteligente."
                android:textColor="#3B5942"
                android:textSize="14sp" />
        </LinearLayout>

    </FrameLayout>

    <!-- CARD PRINCIPAL -->
    <androidx.cardview.widget.CardView
        android:id="@+id/loginCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="220dp"
        app:cardBackgroundColor="#F0F2EB"
        app:cardCornerRadius="32dp"
        app:cardElevation="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/layout_login_usuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingTop="32dp"
                android:paddingEnd="28dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Acesse sua conta"
                    android:textColor="#3B5942"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/poppins"
                    android:text="Entre para continuar e aproveite\ntoda a praticidade do Vallet."
                    android:textColor="#637365"
                    android:textSize="13sp" />

                <!-- EMAIL -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="24dp">

                    <EditText
                        android:id="@+id/editTextText"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/input_pill"
                        android:backgroundTint="#FFFFFF"
                        android:fontFamily="@font/poppins"
                        android:hint="E-mail"
                        android:inputType="textEmailAddress"
                        android:paddingStart="52dp"
                        android:paddingEnd="20dp"
                        android:textColor="#3B5942"
                        android:textColorHint="#97A697"
                        android:textSize="14sp"
                        android:singleLine="true"
                        tools:ignore="Autofill" />

                    <ImageView
                        android:id="@+id/emailimg"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="start|center_vertical"
                        android:layout_marginStart="18dp"
                        android:src="@drawable/email"
                        app:tint="#637365"
                        android:contentDescription="@null" />
                </FrameLayout>

                <!-- SENHA -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="12dp">

                    <EditText
                        android:id="@+id/editTextSenha"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/input_pill"
                        android:backgroundTint="#FFFFFF"
                        android:fontFamily="@font/poppins"
                        android:hint="Senha"
                        android:inputType="textPassword"
                        android:paddingStart="52dp"
                        android:paddingEnd="52dp"
                        android:textColor="#3B5942"
                        android:textColorHint="#97A697"
                        android:textSize="14sp"
                        android:singleLine="true"
                        tools:ignore="Autofill" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="start|center_vertical"
                        android:layout_marginStart="18dp"
                        android:src="@drawable/senha"
                        app:tint="#637365"
                        android:contentDescription="@null" />

                    <ImageView
                        android:id="@+id/senhaimglogin"
                        android:layout_width="17dp"
                        android:layout_height="20dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_eye_off"
                         />
                </FrameLayout>

                <!-- OPÇÕES (Lembrar de mim / Esqueceu a senha) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/cbLembrar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:text="Lembrar de mim"
                        android:textColor="#637365"
                        android:textSize="13sp"
                        android:buttonTint="#3B5942" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/textView5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/poppins"
                        android:text="Esqueceu a senha?"
                        android:textColor="#3B5942"
                        android:textSize="13sp"
                        tools:ignore="TouchTargetSizeCheck" />
                </LinearLayout>

                <!-- BOTÃO ENTRAR -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/button3"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/button_login"
                    android:backgroundTint="#3B5942"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Entrar →"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textAllCaps="false"
                    android:elevation="0dp" />

                <!-- DIVISOR "ou" -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#CBD9C5" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:fontFamily="@font/poppins"
                        android:text="ou"
                        android:textColor="#97A697"
                        android:textSize="13sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#CBD9C5" />
                </LinearLayout>

                <!-- BOTÃO SECUNDÁRIO CRIAR CONTA -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/botaoCadastro"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/button_background_closed"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Criar uma conta"
                    android:textColor="#3B5942"
                    android:textSize="15sp"
                    android:textAllCaps="false" />

            </LinearLayout>
        </ScrollView>
    </androidx.cardview.widget.CardView>

    <!-- LOADING DA TELA -->
    <FrameLayout
        android:id="@+id/progressOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F0F2EB"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:indeterminateTint="#3B5942" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
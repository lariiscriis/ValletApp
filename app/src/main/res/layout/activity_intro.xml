<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vallet_background"
    tools:context=".MainActivity">

    <include
        android:id="@+id/cadastro_progresso"
        layout="@layout/view_progresso_cadastro"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/intro_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintWidth_max="600dp"
        app:layout_constraintTop_toBottomOf="@id/cadastro_progresso"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/intro_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp">

            <!-- Cabeçalho e imagem compartilham a mesma referência de posição. -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/intro_hero"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintVertical_chainStyle="packed"
                app:layout_constraintVertical_bias="0"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/tv_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Ilustração inteira, sem cortar ou distorcer. -->
                <ImageView
                    android:id="@+id/img_illustration"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:layout_marginTop="24dp"
                    android:background="@null"
                    android:contentDescription="Carro verde entrando em uma vaga de estacionamento"
                    android:scaleType="fitCenter"
                    app:layout_constraintDimensionRatio="H,1152:1365"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:srcCompat="@drawable/ic_intro_imagem" />

                <!-- Marca sobre a área transparente da ilustração. -->
                <LinearLayout
                    android:id="@+id/layout_logo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="22dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <ImageView
                        android:id="@+id/img_logo"
                        android:layout_width="227dp"
                        android:layout_height="79dp"
                        android:layout_marginTop="20dp"
                        android:contentDescription="Vallet"
                        android:scaleType="fitStart"
                        app:srcCompat="@drawable/allet" />

                </LinearLayout>

                <!-- Saudação sobre a área transparente à esquerda. -->
<!--                <TextView
                    android:id="@+id/tv_greeting"
                    android:layout_width="137dp"
                    android:layout_height="25dp"
                    android:layout_marginStart="32dp"
                    android:layout_marginTop="16dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/vallet_text"
                    android:textSize="18sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/layout_logo"
                    app:layout_constraintWidth_default="percent"
                    app:layout_constraintWidth_percent="0.58"
                    tools:text="Boas-vindas!" />-->

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Título abaixo da ilustração. -->
            <TextView
                android:id="@+id/tv_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/poppins_bold"
                android:includeFontPadding="false"
                android:lineSpacingExtra="-2dp"
                android:text="Estacione sem esforço, viva sem estresse."
                android:textColor="@color/vallet_text"
                android:textSize="28dp"
                app:layout_constraintTop_toBottomOf="@id/intro_hero"
                app:layout_constraintBottom_toTopOf="@id/tv_subtitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Descrição  -->
            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/poppins_medium"
                android:includeFontPadding="false"
                android:lineSpacingExtra="1dp"
                android:text="Encontre vagas próximas e reserve seu lugar com facilidade."
                android:textColor="@color/vallet_text_secondary"
                android:textSize="13sp"
                app:layout_constraintTop_toBottomOf="@id/tv_title"
                app:layout_constraintBottom_toTopOf="@id/cadastro_bolinhas"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Indicadores abaixo da descrição. -->
            <include
                android:id="@+id/cadastro_bolinhas"
                layout="@layout/view_bolinhas_cadastro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:layout_constraintTop_toBottomOf="@id/tv_subtitle"
                app:layout_constraintBottom_toTopOf="@id/btnIniciar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Botão abaixo dos indicadores. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIniciar"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/poppins_bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0.02"
                android:text="COMEÇAR"
                android:textAllCaps="false"
                android:textColor="@color/vallet_surface"
                android:textSize="18sp"
                app:backgroundTint="@color/vallet_green_dark"
                app:cornerRadius="20dp"
                app:icon="@drawable/baseline_arrow_forward_24"
                app:iconGravity="textEnd"
                app:iconPadding="16dp"
                app:iconSize="24dp"
                app:iconTint="@color/vallet_surface"
                app:layout_constraintTop_toBottomOf="@id/cadastro_bolinhas"
                app:layout_constraintBottom_toTopOf="@id/tv_login_link"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Link abaixo do botão. -->
            <TextView
                android:id="@+id/tv_login_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/poppins_medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minHeight="48dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Já tenho conta"
                android:textColor="@color/vallet_text_secondary"
                android:textSize="15sp"
                app:layout_constraintTop_toBottomOf="@id/btnIniciar"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- LOADING DA TELA -->
    <FrameLayout
        android:id="@+id/progressOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F0F2EB"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/cadastro_progresso"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:indeterminateTint="#3B5942" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
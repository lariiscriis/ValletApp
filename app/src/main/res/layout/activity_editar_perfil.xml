<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vallet_background"
    android:fitsSystemWindows="true">

    <!-- Fundo de ondas decorativo -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.25"
        android:scaleType="centerCrop"
        android:src="@drawable/layered_waves_haikei__4_"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- CABEÇALHO -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingVertical="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnVoltar"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/vallet_green_dark"
            tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:text="Editar Perfil"
            android:textColor="@color/vallet_green_dark"
            android:textSize="18sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- RODAPÉ COM BOTÕES -->
    <LinearLayout
        android:id="@+id/ll_bottom_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSalvar"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/vallet_green_dark"
            android:fontFamily="@font/poppins_semibold"
            android:text="SALVAR ALTERAÇÕES"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            app:cornerRadius="27dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelar"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="CANCELAR"
            android:textColor="@color/vallet_green_dark"
            android:textSize="14sp"
            app:cornerRadius="27dp"
            app:strokeColor="@color/vallet_green_muted"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <!-- CONTEÚDO CENTRAL -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/ll_bottom_buttons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cl_header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <!-- Foto -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cv_edit_profile_pic"
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    app:cardCornerRadius="52dp"
                    app:cardElevation="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:strokeColor="@color/vallet_green_light"
                    app:strokeWidth="2dp">

                    <ImageView
                        android:id="@+id/imgFotoEditar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        tools:src="@tools:sample/avatars" />
                </androidx.cardview.widget.CardView>

                <!-- Badge da câmera  -->
                <ImageView
                    android:id="@+id/btnAlterarFoto"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_camera_badge"
                    android:clickable="true"
                    android:elevation="4dp"
                    android:focusable="true"
                    android:padding="10dp"
                    android:src="@drawable/camera"
                    app:layout_constraintBottom_toBottomOf="@id/cv_edit_profile_pic"
                    app:layout_constraintEnd_toEndOf="@id/cv_edit_profile_pic"
                    app:layout_constraintHorizontal_bias="1.0"
                    app:layout_constraintStart_toStartOf="@id/cv_edit_profile_pic"
                    app:layout_constraintTop_toTopOf="@id/cv_edit_profile_pic"
                    app:layout_constraintVertical_bias="1.0"
                    app:tint="@android:color/white"
                    tools:ignore="TouchTargetSizeCheck,SpeakableTextPresentCheck" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- FORMULÁRIO COMPACTO -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/vallet_green_light"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- CAMPO 1: NOME -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="4dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_box"
                            android:padding="10dp"
                            android:src="@drawable/icons8_person"
                            app:tint="@color/vallet_green" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins"
                                android:text="Nome completo *"
                                android:textColor="@color/vallet_green_muted"
                                android:textSize="12sp" />

                            <EditText
                                android:id="@+id/edtNome"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@null"
                                android:fontFamily="@font/poppins_medium"
                                android:hint="Digite seu nome"
                                android:inputType="textPersonName"
                                android:padding="0dp"
                                android:textColor="@color/vallet_green_dark"
                                android:textColorHint="@color/vallet_green_light"
                                android:textSize="14sp"
                                tools:ignore="TouchTargetSizeCheck"
                                tools:text="João Silva" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="54dp"
                        android:layout_marginVertical="6dp"
                        android:background="@color/vallet_background" />

                    <!-- CAMPO 2: EMAIL -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="4dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_box"
                            android:padding="10dp"
                            android:src="@drawable/email"
                            app:tint="@color/vallet_green" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins"
                                android:text="E-mail *"
                                android:textColor="@color/vallet_green_muted"
                                android:textSize="12sp" />

                            <EditText
                                android:id="@+id/edtEmail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@null"
                                android:fontFamily="@font/poppins_medium"
                                android:hint="Digite seu e-mail"
                                android:inputType="textEmailAddress"
                                android:padding="0dp"
                                android:textColor="@color/vallet_green_dark"
                                android:textColorHint="@color/vallet_green_light"
                                android:textSize="14sp"
                                tools:ignore="TouchTargetSizeCheck"
                                tools:text="joao@gmail.com" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="54dp"
                        android:layout_marginVertical="6dp"
                        android:background="@color/vallet_background" />

                    <!-- CAMPO 3: TELEFONE -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="4dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_box"
                            android:padding="10dp"
                            android:src="@drawable/phone_calling_svgrepo_com"
                            app:tint="@color/vallet_green" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins"
                                android:text="Telefone *"
                                android:textColor="@color/vallet_green_muted"
                                android:textSize="12sp" />

                            <EditText
                                android:id="@+id/edtTelefone"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@null"
                                android:fontFamily="@font/poppins_medium"
                                android:hint="Digite seu telefone"
                                android:inputType="phone"
                                android:padding="0dp"
                                android:textColor="@color/vallet_green_dark"
                                android:textColorHint="@color/vallet_green_light"
                                android:textSize="14sp"
                                tools:ignore="TouchTargetSizeCheck"
                                tools:text="(11) 98765-4321" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="54dp"
                        android:layout_marginVertical="6dp"
                        android:background="@color/vallet_background" />

                    <!-- CAMPO 4: CNH -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="4dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_box"
                            android:padding="10dp"
                            android:src="@drawable/card_2_svgrepo_com"
                            app:tint="@color/vallet_green" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins"
                                android:text="Documento (CNH) *"
                                android:textColor="@color/vallet_green_muted"
                                android:textSize="12sp" />

                            <EditText
                                android:id="@+id/edtCnh"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@null"
                                android:fontFamily="@font/poppins_medium"
                                android:hint="Digite sua CNH"
                                android:inputType="number"
                                android:padding="0dp"
                                android:textColor="@color/vallet_green_dark"
                                android:textColorHint="@color/vallet_green_light"
                                android:textSize="14sp"
                                tools:ignore="TouchTargetSizeCheck"
                                tools:text="1234567890" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
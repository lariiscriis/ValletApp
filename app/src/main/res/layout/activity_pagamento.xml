<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vallet_background">

    <!-- ===================== ETAPA 1: SELEÇÃO DE PAGAMENTO ===================== -->
    <ScrollView
        android:id="@+id/layout_etapa_1_pagamento"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Cabeçalho Compactado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header_vallet"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="20dp"
                android:paddingBottom="32dp">

                <ImageButton
                    android:id="@+id/btn_voltar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icone_chip"
                    android:backgroundTint="@color/vallet_surface"
                    android:contentDescription="Voltar"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/vallet_green_dark"
                    tools:ignore="TouchTargetSizeCheck" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Pagamento"
                    android:textColor="@color/vallet_surface"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_conteudo_pagamento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-24dp"
                android:orientation="vertical"
                android:paddingHorizontal="20dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/vallet_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:text="Detalhes da reserva"
                            android:textColor="@color/vallet_text"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="6dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Local" android:textColor="@color/vallet_text_secondary" android:textSize="13sp"/>
                            <TextView android:id="@+id/tv_resumo_estacionamento" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/vallet_text" android:textSize="13sp" android:textStyle="bold" tools:text="Vallet Center" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="6dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Vaga" android:textColor="@color/vallet_text_secondary" android:textSize="13sp"/>
                            <TextView android:id="@+id/tv_resumo_vaga" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/vallet_text" android:textSize="13sp" android:textStyle="bold" tools:text="A-01" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="6dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Veículo" android:textColor="@color/vallet_text_secondary" android:textSize="13sp"/>
                            <TextView android:id="@+id/tv_resumo_veiculo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/vallet_text" android:textSize="13sp" android:textStyle="bold" tools:text="Fiat Mobi" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="6dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Período" android:textColor="@color/vallet_text_secondary" android:textSize="13sp"/>
                            <TextView android:id="@+id/tv_resumo_horario" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/vallet_text" android:textSize="13sp" android:textStyle="bold" tools:text="14:00 - 15:00" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Tempo cobrado" android:textColor="@color/vallet_text_secondary" android:textSize="13sp"/>
                            <TextView android:id="@+id/tv_resumo_tempo_utilizado" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/vallet_text" android:textSize="13sp" android:textStyle="bold" tools:text="1h" />
                        </LinearLayout>

                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/vallet_card_stroke" android:layout_marginBottom="12dp"/>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Total a pagar" android:textColor="@color/vallet_text" android:textSize="16sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/tv_valor_total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/vallet_green_dark" android:textSize="22sp" android:textStyle="bold" tools:text="R$ 24,00" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="12dp"
                    android:text="Como deseja pagar?"
                    android:textColor="@color/vallet_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Opções de Pagamento -->
                <LinearLayout android:id="@+id/card_pix" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:background="@drawable/bg_card_opcao_padrao" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
                    <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_icone_chip"><ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_pix" app:tint="@color/vallet_green_dark" /></FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PIX" android:textColor="@color/vallet_text" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pagamento instantâneo" android:textColor="@color/vallet_text_secondary" android:textSize="12sp" />
                    </LinearLayout>
                    <ImageView android:id="@+id/iv_check_pix" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_check_circle" app:tint="@color/vallet_green_dark" android:visibility="invisible" />
                </LinearLayout>

                <LinearLayout android:id="@+id/card_credito" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:background="@drawable/bg_card_opcao_padrao" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
                    <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_icone_chip"><ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_credit_card" app:tint="@color/vallet_green_dark" /></FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cartão de crédito" android:textColor="@color/vallet_text" android:textSize="14sp" android:textStyle="bold" />
                    </LinearLayout>
                    <ImageView android:id="@+id/iv_check_credito" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_check_circle" app:tint="@color/vallet_green_dark" android:visibility="invisible" />
                </LinearLayout>

                <LinearLayout android:id="@+id/card_debito" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:background="@drawable/bg_card_opcao_padrao" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
                    <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_icone_chip"><ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_credit_card" app:tint="@color/vallet_green_dark" /></FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cartão de débito" android:textColor="@color/vallet_text" android:textSize="14sp" android:textStyle="bold" />
                    </LinearLayout>
                    <ImageView android:id="@+id/iv_check_debito" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_check_circle" app:tint="@color/vallet_green_dark" android:visibility="invisible" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_explicacao_pix"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="O QR Code será gerado na próxima etapa."
                    android:textColor="@color/vallet_text_secondary"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/layout_campos_cartao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Número do cartão">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_numero_cartao" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:maxLength="19" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="Nome impresso">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_nome_cartao" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapWords" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:layout_weight="1" android:hint="Validade">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_validade_cartao" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:maxLength="5" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_weight="1" android:hint="CVV">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_cvv_cartao" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberPassword" android:maxLength="4" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_confirmar_pagamento"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="24dp"
                    android:text="Confirmar pagamento"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/vallet_green_dark"
                    app:cornerRadius="12dp" />

                <ProgressBar
                    android:id="@+id/progress_bar_pagamento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="16dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ===================== ETAPA 2: QR CODE PIX ===================== -->
    <ScrollView
        android:id="@+id/layout_etapa_2_pix"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/pagamento_qr_fundo"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="22dp"
            android:paddingTop="10dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_voltar_pix"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="-12dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/pagamento_qr_voltar"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/pagamento_qr_verde" />

                <TextView
                    style="@style/PagamentoQrTitulo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/pagamento_qr_pix_titulo" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_pix_gerado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_pix_valor"
                    style="@style/PagamentoQrTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:textSize="39sp"
                    tools:text="R$ 18,00" />

                <TextView
                    android:id="@+id/tv_pix_estacionamento"
                    style="@style/PagamentoQrTexto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:textSize="17sp"
                    tools:text="Estacionamento Central" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:cardBackgroundColor="@color/pagamento_qr_branco"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:layout_constraintDimensionRatio="1:1"
                        app:layout_constraintWidth_max="270dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:id="@+id/iv_qr_code_pagamento"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/pagamento_qr_pix_descricao"
                            android:padding="14dp"
                            android:scaleType="fitCenter" />
                    </com.google.android.material.card.MaterialCardView>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    style="@style/PagamentoQrTexto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="@string/pagamento_qr_pix_instrucao" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_copiar_pix"
                    style="@style/PagamentoQrBotao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/pagamento_qr_pix_copiar"
                    app:icon="@drawable/ic_content_copy"
                    app:iconGravity="textStart"
                    app:iconPadding="12dp"
                    app:iconTint="@color/pagamento_qr_branco" />

                <!-- O conteúdo integral continua disponível ao listener de cópia existente. -->
                <TextView
                    android:id="@+id/tv_codigo_pix_copia_cola"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textIsSelectable="true"
                    android:visibility="gone" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:background="@color/pagamento_qr_claro" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingVertical="12dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_schedule"
                        app:tint="@color/pagamento_qr_secundario" />

                    <TextView
                        style="@style/PagamentoQrTexto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:fontFamily="@font/poppins_medium"
                        android:text="@string/pagamento_qr_pix_status"
                        android:textColor="@color/pagamento_qr_verde" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/pagamento_qr_claro" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_simular_confirmacao_webhook"
                    style="@style/PagamentoQrSimulacao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/pagamento_qr_simular_pagamento" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ===================== ETAPA 3: QR CODE DE SAÍDA ===================== -->
    <ScrollView
        android:id="@+id/layout_etapa_3_sucesso"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/pagamento_qr_fundo"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/layout_sucesso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="22dp"
            android:paddingTop="10dp"
            android:paddingBottom="18dp">

            <TextView
                style="@style/PagamentoQrTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="44dp"
                android:text="@string/pagamento_qr_saida_cabecalho" />

            <ImageView
                android:id="@+id/iv_saida_cancela"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginTop="18dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/pagamento_cancela" />

            <TextView
                android:id="@+id/tv_saida_titulo"
                style="@style/PagamentoQrTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/pagamento_qr_saida_titulo" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:cardBackgroundColor="@color/pagamento_qr_claro"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <TextView
                    style="@style/PagamentoQrTexto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="5dp"
                    android:text="@string/pagamento_qr_saida_status"
                    android:textColor="@color/pagamento_qr_verde" />
            </com.google.android.material.card.MaterialCardView>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:cardBackgroundColor="@color/pagamento_qr_branco"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintWidth_max="216dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/iv_qr_code"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/pagamento_qr_saida_descricao"
                        android:padding="14dp"
                        android:scaleType="fitCenter" />
                </com.google.android.material.card.MaterialCardView>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                style="@style/PagamentoQrTexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/pagamento_qr_saida_instrucao" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:background="@color/pagamento_qr_claro" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="9dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_parking"
                    app:tint="@color/pagamento_qr_verde" />

                <TextView
                    android:id="@+id/tv_sucesso_estacionamento"
                    style="@style/PagamentoQrTexto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:textColor="@color/pagamento_qr_verde"
                    tools:text="Estacionamento Central" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/pagamento_qr_claro" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="9dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_vehicle"
                    app:tint="@color/pagamento_qr_verde" />

                <TextView
                    android:id="@+id/tv_sucesso_vaga"
                    style="@style/PagamentoQrTexto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:textColor="@color/pagamento_qr_verde"
                    tools:text="Vaga A12" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="28dp"
                    android:layout_marginHorizontal="12dp"
                    android:background="@color/pagamento_qr_claro" />

                <TextView
                    android:id="@+id/tv_sucesso_veiculo"
                    style="@style/PagamentoQrTexto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/pagamento_qr_verde"
                    tools:text="Placa ABC1D23" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/pagamento_qr_claro" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_concluir"
                style="@style/PagamentoQrBotao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/pagamento_qr_concluir" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_simular_leitura"
                style="@style/PagamentoQrSimulacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/pagamento_qr_simular_leitura" />

            <!-- Hierarquia do estado de simulação mantida como no fluxo existente. -->
            <LinearLayout
                android:id="@+id/layout_saida_liberada"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone">
                <TextView android:id="@+id/tv_saida_tempo_total" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tv_saida_valor_pago" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tv_sucesso_valor" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
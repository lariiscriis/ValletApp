<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/vallet_background">

    <!-- Cabeçalho -->
    <ImageView
        android:id="@+id/btn_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:padding="12dp"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/vallet_green_dark"
        tools:ignore="SpeakableTextPresentCheck" />

    <TextView
        android:id="@+id/tv_parking_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        android:text="Shopping Praia Grande"
        android:textColor="@color/vallet_green_dark"
        android:textSize="22sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toEndOf="@id/btn_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btn_back"
        app:layout_constraintBottom_toBottomOf="@id/btn_back" />

    <TextView
        android:id="@+id/tv_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="20dp"
        android:text="Escolha sua vaga e garanta seu espaço."
        android:textColor="@color/vallet_green"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="@id/tv_parking_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_parking_name" />

    <!-- Filtros -->
    <HorizontalScrollView
        android:id="@+id/scroll_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:clipToPadding="false"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/tv_subtitle">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_tipo_vaga"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:chipSpacingHorizontal="8dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_todos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:checked="true"
                app:chipStrokeWidth="1dp"
                app:chipStrokeColor="@color/vallet_green_dark"
                android:text="Todos" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_carro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                app:chipStrokeWidth="1dp"
                app:chipStrokeColor="@color/vallet_green_dark"
                android:text="Carro" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_moto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                app:chipStrokeWidth="1dp"
                app:chipStrokeColor="@color/vallet_green_dark"
                android:text="Moto" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_preferencial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                app:chipStrokeWidth="1dp"
                app:chipStrokeColor="@color/vallet_green_dark"
                android:text="Preferencial" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Planta do estacionamento -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/plant_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/scroll_chips"
        app:layout_constraintBottom_toTopOf="@id/bottom_panel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.5" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="26dp"
            android:background="@drawable/bg_plant_section"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/guideline_center" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="26dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_plant_section"
            app:layout_constraintStart_toEndOf="@id/guideline_center"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Corredor central: Saída -->
        <TextView
            android:id="@+id/tv_saida"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Saída\n↑"
            android:gravity="center"
            android:textColor="@color/vallet_green"
            android:textSize="12sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="@id/guideline_center"
            app:layout_constraintEnd_toEndOf="@id/guideline_center" />

        <!-- Linha tracejada conectando a Saída ao Carro -->
        <View
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/dashed_line"
            android:layerType="software"
            app:layout_constraintTop_toBottomOf="@id/tv_saida"
            app:layout_constraintBottom_toTopOf="@id/iv_carro_entrada"
            app:layout_constraintStart_toStartOf="@id/guideline_center"
            app:layout_constraintEnd_toEndOf="@id/guideline_center" />

        <!-- Carro na entrada do corredor -->
        <ImageView
            android:id="@+id/iv_carro_entrada"
            android:layout_width="40dp"
            android:layout_height="70dp"
            android:src="@drawable/carro_vagaocupada"
            android:layout_marginBottom="4dp"
            app:layout_constraintBottom_toTopOf="@id/tv_entrada"
            app:layout_constraintStart_toStartOf="@id/guideline_center"
            app:layout_constraintEnd_toEndOf="@id/guideline_center" />

        <!-- Corredor central: Entrada -->
        <TextView
            android:id="@+id/tv_entrada"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="↑\nEntrada"
            android:gravity="center"
            android:textColor="@color/vallet_green"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@id/guideline_center"
            app:layout_constraintEnd_toEndOf="@id/guideline_center" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:overScrollMode="never"
            android:background="@android:color/transparent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Painel inferior -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottom_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/vallet_surface"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_selected_spot_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Selecione uma vaga"
                        android:textColor="@color/vallet_green_dark"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_selected_spot_details"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Planta interativa"
                        android:textColor="@color/vallet_green"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_preco_reserva"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R$ --"
                    android:textColor="@color/vallet_green_dark"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_reservar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:text="Reservar vaga"
                android:textAllCaps="false"
                android:textSize="16sp"
                app:cornerRadius="28dp"
                app:backgroundTint="@color/vallet_green_dark"
                app:icon="@drawable/calendar_add"
                app:iconGravity="textStart" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">

            <solid android:color="#FFFFFF" />

            <stroke
                android:width="2dp"
                android:color="#BEE5B0" />

            <corners android:radius="30dp" />

            <padding
                android:left="18dp"
                android:top="0dp"
                android:right="18dp"
                android:bottom="0dp" />

        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">

            <solid android:color="#FFFFFF" />

            <stroke
                android:width="1dp"
                android:color="#E3E3E3" />

            <corners android:radius="30dp" />

            <padding
                android:left="18dp"
                android:top="0dp"
                android:right="18dp"
                android:bottom="0dp" />

        </shape>
    </item>

</selector>